# Copy to .env and fill in what you use. Everything here is optional:
# without it the pipeline runs fully locally and logs to stdout.

# --- Weights & Biases (train.py) ---
WANDB_API_KEY=
WANDB_ENTITY=

# --- AWS S3 (preprocess.py --pull/--push, train.py --s3) ---
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-1
# Only for S3-compatible providers (MinIO, R2, ...)
S3_ENDPOINT_URL=
